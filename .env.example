# The local TrueForge URL shown by `npx @truefoundry/trueforge`.
VITE_TRUEFORGE_URL=http://localhost:8790

# Do not add OPENAI_API_KEY here. Configure it once in TrueForge's local
# Settings → Models → OpenAI screen; TrueForge persists and redacts it in its
# own local provider catalog.

# Team-owned AWS sandbox identity. Use an authenticated local SSO profile;
# never put long-lived AWS access keys in this file.
AWS_PROFILE=iamender-sandbox
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=

# IAMender agent safety switches. Keep writes disabled until the TrueForge
# approval checkpoint has supplied a real approval ID for a sandbox change.
IAMENDER_ALLOW_WRITE=false
IAMENDER_TARGET_POLICY_ARN=

# LocalStack development mode. Uncomment these values to run the complete demo
# locally. LocalStack uses non-secret dummy credentials and never calls AWS.
# IAMENDER_LOCAL_MODE=true
# IAMENDER_AWS_ENDPOINT_URL=http://localhost:4566
# LOCALSTACK_AUTH_TOKEN=

# TrueForge agent integration. Configure the OpenAI key in TrueForge itself,
# then set its configured model name here. This is not an API key.
IAMENDER_TRUEFORGE_URL=http://localhost:8790
IAMENDER_TRUEFORGE_MODEL=
IAMENDER_MCP_URL=http://127.0.0.1:8788/mcp
